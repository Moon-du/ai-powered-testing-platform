APP_ENV=development
APP_NAME=AI Powered Test Engineering Platform
API_V1_PREFIX=/api/v1
POSTGRES_DB=test_platform
POSTGRES_USER=test_platform
# Local Compose embeds this value in a SQLAlchemy URL; use URL-safe characters only.
POSTGRES_PASSWORD=
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=test-platform
OBJECT_STORAGE_SECURE=false
AI_TASK_MODE=celery
LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_VISION_MODEL=deepseek-v4-flash-vision-exp
LLM_TIMEOUT_SECONDS=120
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192
PROMPT_VERSION=deepseek-v1
VALIDATOR_VERSION=p0-domain-v1
POLICY_VERSION=p0-guardrail-v1
OIDC_ISSUER=
OIDC_AUDIENCE=
DEV_AUTH_ENABLED=true
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_DEV_HEADERS=true
VITE_DEV_USER_ID=dev-user
VITE_DEV_ACTOR_ROLE=OWNER
VITE_DEV_TENANT_ID=local-tenant
